<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Shop &mdash; Mat&eacute;riel de p&acirc;tisserie</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css" />
  <link rel="stylesheet" href="mobile.css" media="(max-width: 768px)">
  <link rel="stylesheet" href="theme-glass.css">
  <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#0b0c0f">
</head>
<body>
  <!-- Header identique -->
  <header class="site-header bubbled ps-glass-nav">
    <a class="brand" href="home.html">
      <img class="brand-mark" src="assets/logo-ps.png" alt="Palet Sucr&eacute;"/>
      <span class="brand-name">Palet Sucr&eacute;</span>
    </a>
    <nav class="nav" id="site-nav">
  <a href="home.html">Accueil</a>
  <a href="shop.html">Commander un g&acirc;teau</a>   <!-- <- vers TON ancienne page -->
  <a href="shop-materiel.html">Shop</a>         <!-- <- nouvelle page matÃ©riel -->
  <a href="inthebox.html">In The Box</a>
  <a href="atelier.html">L'Atelier</a>
  <button id="open-cart" class="cart-btn">Panier <span id="cart-count" class="badge">0</span></button>
</nav>
  </header>

  <!-- Section SHOP -->
  <main class="section shop-page">
            <section class='shop-hero' style='text-align:center'>
      <h1>Formations &amp; Kits de p&acirc;tisserie</h1>
      <p>Accessoires et formations s&eacute;lectionn&eacute;s par Palet Sucr&eacute; pour des finitions propres et &eacute;l&eacute;gantes.</p>
    </section>

        <div class="grid cards" id="gear-grid">
      <article class="card ps-glass-card">
        <div class="card-body">
          <h3>Kit D&eacute;butant P&acirc;tisserie</h3>
          <p>Bient&ocirc;t disponible.</p>
        </div>
      </article>

      <article class="card ps-glass-card">
        <div class="card-body">
          <h3>IA x Palet Sucr&eacute;</h3>
          <p>Bient&ocirc;t disponible.</p>
        </div>
      </article>
    </div>

    <!-- Fiche produit (overlay) -->
    <div id="product-overlay" class="cart-overlay" aria-hidden="true">
      <aside class="product-panel" role="dialog" aria-labelledby="product-title">
        <button class="icon-btn product-close" aria-label="Fermer">&times;</button>
        <div class="product-body">
          <div class="product-media">
            <img id="product-image" alt="">
          </div>
          <div class="product-info">
            <h2 id="product-title"></h2>
            <p id="product-desc" class="sub"></p>
            <div class="servings">
              <label for="servings-select">QuantitÃ©</label>
              <select id="servings-select" class="input" style="max-width:220px"></select>
            </div>
            <div class="price-row" style="margin-top:10px">
              <strong id="product-price"></strong>
              <button id="product-add" class="btn btn-primary add-to-cart">Ajouter au panier</button>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

    <footer class="site-footer">
    <p>&copy; <span id="year"></span> Palet Sucr&eacute; &mdash; Tous droits r&eacute;serv&eacute;s.</p>
  </footer>

  <!-- Panier rÃ©utilisÃ© -->
  <div id="cart-overlay" class="cart-overlay" aria-hidden="true">
    <aside class="cart-panel" role="dialog" aria-labelledby="cart-title">
      <header class="cart-header">
        <h2 id="cart-title">Votre panier</h2>
        <button id="cart-close" class="icon-btn" aria-label="Fermer">&times;</button>
      </header>
      <ul id="cart-list" class="cart-list"></ul>
      <footer class="cart-footer">
        <div class="cart-total">Total: <strong><span id="cart-total">0,00â‚¬</span></strong></div>
        <a class="btn btn-primary w-full" href="shop.html#checkout">Finaliser la commande</a>
      </footer>
    </aside>
  </div>

  <script src="scripts/cart.js"></script>
  <script src="scripts/shop.js"></script>
  <script src="scripts/main.js"></script>
</body>
</html>
















